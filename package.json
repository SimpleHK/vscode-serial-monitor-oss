{
  "name": "serial-lens",
  "displayName": "Serial Lens",
  "description": "Tag highlighting, a display-layer filter, and editor-style find for serial streams in VS Code. Multi-port split view, live reconnect, log to file. Independent, MIT, no telemetry.",
  "version": "0.6.0",
  "license": "MIT",
  "publisher": "simplehk",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimpleHK/vscode-serial-monitor-oss"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "serialMonitor.open",
        "title": "Open Monitor",
        "category": "Serial Lens"
      },
      {
        "command": "serialMonitor.openLogFile",
        "title": "Open Log File...",
        "category": "Serial Lens"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "serialMonitor",
          "title": "Serial Lens",
          "icon": "assets/serial-monitor.svg"
        }
      ]
    },
    "views": {
      "serialMonitor": [
        {
          "type": "webview",
          "id": "serialMonitor.view",
          "name": "Serial Monitor"
        }
      ]
    },
    "configuration": {
      "title": "Serial Monitor",
      "properties": {
        "serialLens.maxBufferLines": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "description": "Receive buffer cap in lines; the oldest lines drop out beyond it (applies live)."
        },
        "serialLens.recentBaudRates": {
          "type": "array",
          "default": [],
          "description": "Recently used baud rates, shown first in the quick-pick."
        },
        "serialLens.logDirectory": {
          "type": "string",
          "default": "",
          "description": "Directory for per-session serial logs: each monitoring session creates a new timestamped .log file there."
        },
        "serialLens.timestamps": {
          "type": "boolean",
          "default": true,
          "description": "Show a receive timestamp at the start of each line (display decoration only; tag matching always uses raw line content)."
        },
        "serialLens.portTags": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-port tag sets (ADR-0006): a map of port path to that port’s tags. Usually managed from the monitor UI.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "name",
              "pattern",
              "isRegex",
              "color",
              "highlight",
              "filter"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identity used by the UI (assigned automatically)."
              },
              "name": {
                "type": "string",
                "description": "Display name."
              },
              "pattern": {
                "type": "string",
                "description": "Literal substring, or regex source when isRegex is true."
              },
              "isRegex": {
                "type": "boolean",
                "description": "Whether pattern is a regular expression instead of a substring."
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "Hex color used for the full-line highlight and the chip."
              },
              "highlight": {
                "type": "boolean",
                "description": "Participates in full-line highlighting."
              },
              "filter": {
                "type": "boolean",
                "description": "Participates in filtering (with the global filter mode)."
              },
              "enabled": {
                "type": "boolean",
                "description": "Legacy single switch; migrated to highlight/filter on load."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "npx --yes @vscode/vsce package",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check:manifest": "node scripts/check-manifest.mjs",
    "stop:feeder": "node scripts/stop-feeder.mjs",
    "feeder": "node scripts/virtual-device.mjs",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-count.json && node scripts/check-test-count.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run build && node scripts/build-integration.mjs && node scripts/stop-feeder.mjs && node dist/integration/runTest.js",
    "preview:webview": "node scripts/webview-preview.mjs",
    "smoke:check": "node scripts/vserial-check.mjs",
    "smoke:device": "node scripts/virtual-device.mjs"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.24.0",
    "gifenc": "^1.0.3",
    "happy-dom": "^21.0.4",
    "mocha": "^11.8.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "ws": "^8.22.1"
  },
  "icon": "assets/icon.png",
  "keywords": [
    "serial",
    "serial port",
    "monitor",
    "hardware",
    "embedded",
    "uart",
    "arduino",
    "esp32",
    "logs"
  ],
  "galleryBanner": {
    "color": "#1f2733",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://github.com/SimpleHK/vscode-serial-monitor-oss/actions/workflows/ci.yml/badge.svg",
      "href": "https://github.com/SimpleHK/vscode-serial-monitor-oss/actions/workflows/ci.yml",
      "description": "CI"
    }
  ],
  "activationEvents": [
    "onStartupFinished"
  ]
}
